VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini runs in the Supabase Edge Function `gemini`. Do not put the API key in this file.
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite
#   supabase functions deploy gemini
# Also run the storage section at the bottom of supabase/schema.sql.
